{
  "MC_Power": {
    "category": "Control",
    "description": "Enable/Disable axis power",
    "inputs": {
      "Enable": { "type": "BOOL", "description": "Power enable command" },
      "EnablePositive": { "type": "BOOL", "description": "Enable positive direction" },
      "EnableNegative": { "type": "BOOL", "description": "Enable negative direction" },
      "BufferMode": { "type": "INT", "description": "Buffer mode" }
    },
    "outputs": {
      "Status": { "type": "BOOL", "description": "Power is enabled" },
      "Busy": { "type": "BOOL", "description": "Powering on/off in progress" },
      "Active": { "type": "BOOL", "description": "FB is active" },
      "Error": { "type": "BOOL", "description": "Error occurred" },
      "ErrorID": { "type": "UINT", "description": "Error code" }
    },
    "inout": {
      "Axis": { "type": "AXIS_REF", "description": "Axis reference" }
    }
  },
  "MC_Reset": {
