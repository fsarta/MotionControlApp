    </Struct>
    <Enumeration type="QualityFlags" baseType="uint32">
      <Symbols>
        <Symbol name="None" value="0"/>
        <Symbol name="DeviceDefect" value="1"/>
        <Symbol name="PowerFailure" value="2"/>
        <Symbol name="WireBreak" value="4"/>
        <Symbol name="Failure" value="8"/>
        <Symbol name="OutOfRange" value="192"/>
        <Symbol name="Overrange" value="64"/>
        <Symbol name="Underrange" value="128"/>
        <Symbol name="BadReference" value="512"/>
        <Symbol name="Oscillatory" value="1024"/>
        <Symbol name="Outdated" value="2048"/>
        <Symbol name="Inconsistent" value="4096"/>
        <Symbol name="Inaccurate" value="8192"/>
        <Symbol name="Source" value="33554432"/>
        <Symbol name="Blocked" value="67108864"/>
        <Symbol name="Test" value="134217728"/>
      </Symbols>
    </Enumeration>
    <Enumeration type="QualityState" baseType="uint8">
      <Symbols>
        <Symbol name="None" value="0"/>
        <Symbol name="Good" value="1"/>
        <Symbol name="Questionable" value="2"/>
        <Symbol name="Invalid" value="128"/>
        <Symbol name="Bad" value="255"/>
      </Symbols>
    </Enumeration>
